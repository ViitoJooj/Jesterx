# postgres
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=
POSTGRES_HOST=
POSTGRES_SSL=

# jwt
JWT_ACCESS_TOKEN=
JWT_REFRESH_TOKEN=

# environment
# dev or prod
ENVIRONMENT=

# resend
RESEND_KEY=

# stripe
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=

# storage local — pasta onde os arquivos enviados serão salvos
# Subpastas: images/, videos/, docs/
STORAGE_PATH=

# frontend
FRONTEND_URL=
BACKEND_URL=

# stripe webhook (optional — leave empty to skip signature validation in dev)
STRIPE_WEBHOOK_SECRET=

# platform commission percentage (optional — defaults to 5%)
PLATFORM_COMMISSION_PCT=5

# frontend (vite) — VITE_* são expostos no bundle JS
VITE_WEBSITE_ID=
VITE_API_URL=
